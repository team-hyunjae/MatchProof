{
  "name": "matchproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "contract:compile": "node scripts/compile.mjs",
    "contract:check": "node scripts/compile.mjs --skip-zk",
    "matchproof:check": "node scripts/compile.mjs --matchproof --skip-zk",
    "matchproof:compile": "node scripts/compile.mjs --matchproof",
    "matchproof:smoke": "tsx scripts/matchproof-smoke.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "assets:copy": "node scripts/copy-assets.mjs",
    "predev": "node scripts/copy-assets.mjs --optional",
    "prebuild": "npm run assets:copy",
    "network:up": "docker compose -p matchproof -f infra/compose.yml up -d",
    "network:down": "docker compose -p matchproof -f infra/compose.yml down",
    "demo": "node scripts/matchproof-demo.mjs",
    "predemo": "npm run build",
    "doctor": "node scripts/doctor.mjs",
    "doctor:network": "node scripts/doctor.mjs --network",
    "demo:wallet": "tsx scripts/matchproof-browser-wallet.ts",
    "setup:compiler": "node scripts/setup-compiler.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "assert": "2.1.0",
    "buffer": "6.0.3",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "process": "0.11.10",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "pino": "10.3.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vite-plugin-wasm": "3.5.0"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "description": "Private eligibility checks for matchmaking agency admission on Midnight Local Devnet."
}
