pragma language_version 0.23;

import CompactStandardLibrary;

// No names, student numbers, eligibility reasons, or private keys enter the ledger.
// Each deployment represents one school and one support programme.
export ledger programId: Bytes<32>;
export ledger issuerKeyHash: Bytes<32>;
export ledger members: MerkleTree<10, Bytes<32>>;
export ledger registered: Set<Bytes<32>>;
export ledger merchants: Set<Bytes<32>>;
export ledger spent: Set<Bytes<32>>;
export ledger receipts: Map<Bytes<32>, Bytes<32>>;
export ledger issuedCount: Counter;
export ledger redeemedCount: Counter;

witness issuerSecret(): Bytes<32>;
witness studentSecret(): Bytes<32>;
witness membershipPath(): MerkleTreePath<10, Bytes<32>>;

constructor(program: Bytes<32>, issuer: Bytes<32>, merchantA: Bytes<32>, merchantB: Bytes<32>) {
  programId = disclose(program);
  issuerKeyHash = disclose(issuer);
  merchants.insert(disclose(merchantA));
  merchants.insert(disclose(merchantB));
}

export circuit issuerCommitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "quietpass:issuer:v1"), secret]);
}

export circuit credentialCommitment(program: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "quietpass:member:v1"), program, secret]);
}

export circuit dailyNullifier(program: Bytes<32>, secret: Bytes<32>, day: Uint<32>): Bytes<32> {
  // Merchant is deliberately excluded: moving between shops cannot reset a daily allowance.
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "quietpass:spend:v1"), program, secret, day as Field as Bytes<32>]);
}

export circuit issue(commitment: Bytes<32>): [] {
  assert(issuerCommitment(issuerSecret()) == issuerKeyHash, "ISSUER_UNAUTHORIZED");
  const publicCommitment = disclose(commitment);
  assert(!registered.member(publicCommitment), "CREDENTIAL_EXISTS");
  assert(!members.isFull(), "PROGRAM_FULL");
  members.insert(publicCommitment);
  registered.insert(publicCommitment);
  issuedCount.increment(1);
}

export circuit redeem(day: Uint<32>, merchant: Bytes<32>): Bytes<32> {
  const publicDay = disclose(day);
  const publicMerchant = disclose(merchant);
  assert(merchants.member(publicMerchant), "MERCHANT_UNKNOWN");

  // Unix day in Korea (UTC+9). The ledger, not the user's clock, authorizes the day.
  assert(publicDay > 0, "DAY_INVALID");
  const start = ((publicDay as Uint<64>) * 86400 - 32400) as Uint<64>;
  assert(blockTimeGte(start), "DAY_NOT_STARTED");
  assert(blockTimeLt((start + 86400) as Uint<64>), "DAY_EXPIRED");

  const secret = studentSecret();
  const path = membershipPath();
  // Both leaf ownership and path validity are essential: a valid path alone is insufficient.
  assert(path.leaf == credentialCommitment(programId, secret), "CREDENTIAL_MISMATCH");
  const root = merkleTreePathRoot<10, Bytes<32>>(path);
  assert(members.checkRoot(disclose(root)), "MEMBERSHIP_INVALID");

  const nullifier = disclose(dailyNullifier(programId, secret, publicDay));
  assert(!spent.member(nullifier), "ALREADY_REDEEMED");
  spent.insert(nullifier);
  receipts.insert(nullifier, publicMerchant);
  redeemedCount.increment(1);
  return nullifier;
}
